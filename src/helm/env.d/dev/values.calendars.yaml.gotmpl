djangoSecretKey: &djangoSecretKey "lkjsdlfkjsldkfjslkdfjslkdjfslkdjf"
djangoSuperUserEmail: admin@example.com
djangoSuperUserPass: admin
caldavInboundApiKey: &caldavInboundApiKey "ThisIsAnExampleKeyForDevPurposeOnly"
caldavOutboundApiKey: &caldavOutboundApiKey "ThisIsAnExampleKeyForDevPurposeOnly"
caldavInternalApiKey: &caldavInternalApiKey "ThisIsAnExampleKeyForDevPurposeOnly"
oidc:
    clientId: calendars
    clientSecret: ThisIsAnExampleKeyForDevPurposeOnly

image:
  repository: localhost:5001/calendars-backend
  pullPolicy: Always
  tag: "latest"

backend:
  replicas: 1
  envVars:
    APP_URL: https://calendars.127.0.0.1.nip.io
    DJANGO_CSRF_TRUSTED_ORIGINS: https://calendars.127.0.0.1.nip.io
    DJANGO_CONFIGURATION: Feature
    DJANGO_ALLOWED_HOSTS: calendars.127.0.0.1.nip.io
    DJANGO_SECRET_KEY: *djangoSecretKey
    DJANGO_SETTINGS_MODULE: calendars.settings
    DJANGO_SUPERUSER_PASSWORD: admin
    DEFAULT_FROM_EMAIL: noreply@example.com
    EMAIL_HOST: "mailcatcher"
    EMAIL_PORT: 1025
    EMAIL_USE_SSL: False
    LOGGING_LEVEL_LOGGERS_ROOT: INFO
    LOGGING_LEVEL_LOGGERS_APP: INFO
    OIDC_USERINFO_FULLNAME_FIELDS: "name"
    OIDC_OP_JWKS_ENDPOINT: https://calendars-keycloak.127.0.0.1.nip.io/realms/calendars/protocol/openid-connect/certs
    OIDC_OP_AUTHORIZATION_ENDPOINT: https://calendars-keycloak.127.0.0.1.nip.io/realms/calendars/protocol/openid-connect/auth
    OIDC_OP_TOKEN_ENDPOINT: https://calendars-keycloak.127.0.0.1.nip.io/realms/calendars/protocol/openid-connect/token
    OIDC_OP_USER_ENDPOINT: https://calendars-keycloak.127.0.0.1.nip.io/realms/calendars/protocol/openid-connect/userinfo
    OIDC_OP_LOGOUT_ENDPOINT: https://calendars-keycloak.127.0.0.1.nip.io/realms/calendars/protocol/openid-connect/logout
    OIDC_REDIRECT_ALLOWED_HOSTS: "https://calendars.127.0.0.1.nip.io"
    OIDC_RP_CLIENT_ID: calendars
    OIDC_RP_CLIENT_SECRET: ThisIsAnExampleKeyForDevPurposeOnly
    OIDC_RP_SIGN_ALGO: RS256
    OIDC_RP_SCOPES: "openid email"
    LOGIN_REDIRECT_URL: https://calendars.127.0.0.1.nip.io
    LOGIN_REDIRECT_URL_FAILURE: https://calendars.127.0.0.1.nip.io
    LOGOUT_REDIRECT_URL: https://calendars.127.0.0.1.nip.io
    DB_HOST: dev-backend-postgres
    DB_NAME:
      secretKeyRef:
        name: dev-backend-postgres
        key: database
    DB_USER:
      secretKeyRef:
        name: dev-backend-postgres
        key: username
    DB_PASSWORD:
      secretKeyRef:
        name: dev-backend-postgres
        key: password
    DB_PORT: 5432
    REDIS_URL: redis://user:pass@dev-backend-redis:6379/0
    DRAMATIQ_BROKER_URL: redis://user:pass@dev-backend-redis:6379/0
    DRAMATIQ_RESULT_BACKEND_URL: redis://user:pass@dev-backend-redis:6379/1
    STORAGES_STATICFILES_BACKEND: django.contrib.staticfiles.storage.StaticFilesStorage
    CALDAV_URL: http://calendars-caldav:80
    CALDAV_INBOUND_API_KEY: *caldavInboundApiKey
    CALDAV_OUTBOUND_API_KEY: *caldavOutboundApiKey
    CALDAV_INTERNAL_API_KEY: *caldavInternalApiKey
    CACHES_DEFAULT_KEY_PREFIX: "{{ now | unixEpoch }}"
  django:
    envVars:
      WEB_CONCURRENCY: 1

  migrate:
    command:
      - "/bin/sh"
      - "-c"
      - |
        attempt=0
        until output=$(python manage.py check --database default 2>&1)
        do
          attempt=$((attempt + 1))
          echo "Database check failed (attempt $attempt), retrying in 2s:"
          echo "$output"
          sleep 2
        done

        echo "Database is ready"

        python manage.py migrate --no-input
    restartPolicy: Never

  command:
    - "gunicorn"
    - "-c"
    - "/app/gunicorn.conf.py"
    - "calendars.wsgi:application"

  createsuperuser:
    command:
      - "/bin/sh"
      - "-c"
      - |
        attempt=0
        until output=$(python manage.py check --database default 2>&1)
        do
          attempt=$((attempt + 1))
          echo "Database check failed (attempt $attempt), retrying in 2s:"
          echo "$output"
          sleep 2
        done

        echo "Database is ready"
        python manage.py createsuperuser --email admin@example.com --password admin
    restartPolicy: Never

  # Extra volume mounts to manage our local custom CA and avoid to set ssl_verify: false
  extraVolumeMounts:
    - name: certs
      mountPath: /cert/cacert.pem
      subPath: cacert.pem

  # Extra volumes to manage our local custom CA and avoid to set ssl_verify: false
  extraVolumes:
    - name: certs
      configMap:
        name: certifi
        items:
        - key: cacert.pem
          path: cacert.pem

frontend:
  envVars:
    PORT: 8080

  replicas: 1

  image:
    repository: localhost:5001/calendars-frontend
    pullPolicy: Always
    tag: "latest"

caldav:
  replicas: 1

  image:
    repository: localhost:5001/calendars-caldav
    pullPolicy: Always
    tag: "latest"

  envVars:
    PGHOST: dev-backend-postgres
    PGPORT: 5432
    PGDATABASE:
      secretKeyRef:
        name: dev-backend-postgres
        key: database
    PGUSER:
      secretKeyRef:
        name: dev-backend-postgres
        key: username
    PGPASSWORD:
      secretKeyRef:
        name: dev-backend-postgres
        key: password
    CALDAV_DB_SCHEMA: sabre
    CALDAV_BASE_URI: /caldav/
    CALDAV_CALLBACK_BASE_URL: http://calendars-backend:80
    CALDAV_INBOUND_API_KEY: *caldavInboundApiKey
    CALDAV_OUTBOUND_API_KEY: *caldavOutboundApiKey
    CALDAV_INTERNAL_API_KEY: *caldavInternalApiKey

ingress:
  enabled: true
  host: calendars.127.0.0.1.nip.io
  annotations:
    nginx.ingress.kubernetes.io/proxy-body-size: 20m

ingressAdmin:
  enabled: true
  host: calendars.127.0.0.1.nip.io
