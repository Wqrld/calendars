postgres:
  enabled: true
  name: postgres
  #serviceNameOverride: postgres
  image: postgres:16-alpine
  username: dinum
  password: pass
  database: calendars
  size: 5Gi
redis:
  enabled: true
  name: redis
  image: redis:8.2-alpine
  username: user
  password: pass
keycloak:
  enabled: true
  image: quay.io/keycloak/keycloak:20.0.1
  name: keycloak
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt
  #serviceNameOverride: keycloak
  hostname: {{ .Values.feature }}-calendars-keycloak.{{ .Values.domain }}
  username: admin
  password: pass
  tls:
    enabled: true
    secretName: calendars-tls
  db:
    username: dinum
    password: pass
    database: keycloak
    size: 5Gi
    image: postgres:16-alpine
  realm:
    name: calendars
    username: calendars
    password: calendars
    email: calendars@example.com
